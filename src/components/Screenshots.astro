---
// The app itself, one view at a time, in Light or Dark to match the page.
// The images are public/screenshots/, taken by scripts/screenshots.py.

const views = [
  {
    id: 'browse',
    label: 'Browse',
    caption:
      'Browse by author, series, tag, publisher, format, language and more; open a category wide to see every value, merge the ones that are one thing spelt several ways, or let Tidy Up find them.',
  },
  {
    id: 'edit',
    label: 'Edit',
    caption:
      'Every field in one window, with autocomplete, a cover you can swap, and Find Metadata to fill the rest from Open Library, Google Books or a plugin.',
  },
  {
    id: 'settings',
    label: 'Settings',
    caption:
      'The library you have open, what it holds on disk, and keeping your EPUB files’ own metadata matching the library.',
  },
];
const img = 'block h-auto w-full drop-shadow-[0_12px_32px_color-mix(in_srgb,var(--shadow)_35%,transparent)]';
---

<div data-shots>
  <div
    class="mx-auto mb-5 flex w-fit gap-0.5 rounded-control bg-element p-0.75"
    role="tablist"
    aria-label="Screenshots"
  >
    {views.map((v, i) => (
      <button
        type="button"
        role="tab"
        id={`shot-tab-${v.id}`}
        aria-controls={`shot-${v.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="cursor-pointer rounded-inset px-4 py-1.5 text-sm/[1.2] font-medium text-muted hover:text-fg aria-selected:bg-popover aria-selected:text-fg aria-selected:shadow-card"
      >
        {v.label}
      </button>
    ))}
  </div>
  {views.map((v, i) => (
    <figure id={`shot-${v.id}`} role="tabpanel" aria-labelledby={`shot-tab-${v.id}`} hidden={i !== 0}>
      <img
        class={`${img} dark:hidden`}
        src={`screenshots/light-${v.id}.webp`}
        alt={`Magnitide’s ${v.id} view, in the Light theme`}
        width="2200"
        height="1410"
        loading="lazy"
        decoding="async"
      />
      <img
        class={`${img} hidden dark:block`}
        src={`screenshots/dark-${v.id}.webp`}
        alt={`Magnitide’s ${v.id} view, in the Dark theme`}
        width="2200"
        height="1410"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mx-auto mt-4.5 max-w-[62ch] text-center text-[0.95rem] text-muted">{v.caption}</figcaption>
    </figure>
  ))}
</div>

<script>
  // One view at a time; the arrow keys move between tabs.
  for (const shots of document.querySelectorAll('[data-shots]')) {
    const tabs = [...shots.querySelectorAll<HTMLElement>('[role=tab]')];
    const select = (tab: HTMLElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = tabs[(i + step + tabs.length) % tabs.length]!;
        select(next);
        next.focus();
      });
    });
  }
</script>
