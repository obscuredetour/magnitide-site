---
import type { AstroComponent } from '@lucide/astro';
import Icon from './Icon.astro';

// A feature card: an icon, a title, some text, and maybe a link to more.
interface Props {
  icon: AstroComponent;
  title: string;
  more?: { href: string; label: string };
}

const { icon, title, more } = Astro.props;
---

<article class="flex flex-col gap-2.5 rounded-card border border-line bg-panel p-5.5 text-[0.95rem] text-muted [&_ul]:list-disc [&_ul]:pl-4.5 [&_li+li]:mt-1">
  <div class="grid size-9 place-items-center rounded-control bg-highlight text-accent">
    <Icon of={icon} size={20} />
  </div>
  <h3 class="font-sans text-[1.05rem] tracking-normal text-fg">{title}</h3>
  <slot />
  {more && (
    <a class="mt-auto pt-1.5 text-[0.9rem] font-medium" href={more.href}>
      {more.label} →
    </a>
  )}
</article>
