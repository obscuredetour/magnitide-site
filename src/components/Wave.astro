---
// The wave over the mark's four slabs (Mark.tsx in the app): one sine cycle,
// rising first, its crest a quarter of the way along and its trough three
// quarters. In the mark it's y = 11.815 − 10.615·sin(2πx/54) across a 54-wide
// box; here it's stretched to whatever box it's given, with an even line, in
// the accent colour.
interface Props {
  class?: string;
  /** Line width in pixels. */
  width?: number;
}

const { class: className, width = 5 } = Astro.props;

// The mark's wave, sampled finely enough to be smooth at any size.
const steps = 216;
const points = Array.from({ length: steps + 1 }, (_, i) => {
  const x = (54 * i) / steps;
  const y = 11.815 - 10.615 * Math.sin((2 * Math.PI * x) / 54);
  return `${x.toFixed(3)} ${y.toFixed(3)}`;
});
---

<svg
  class:list={['pointer-events-none text-accent', className]}
  viewBox="0 0 54 23.63"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
>
  <path
    d={`M${points.join(' L')}`}
    stroke="currentColor"
    stroke-width={width}
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  ></path>
</svg>
